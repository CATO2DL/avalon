{
  "name": "qingzhou-avalon-core",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Avalon rules engine with a local single-player practice and public sandbox",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "demo": "node scripts/demo.mjs",
    "check": "npm run typecheck && npm test && npm run demo",
    "visual": "node scripts/visual-server.mjs",
    "start": "node --env-file-if-exists=.env scripts/room-server.mjs",
    "lan": "node --env-file-if-exists=.env scripts/room-server.mjs --lan",
    "test:rooms": "node --test tests/multiplayer.test.mjs",
    "test:browser": "node scripts/test-multiplayer-browser.mjs",
    "setup:tools": "npm install --prefix .local/toolchain --cache .local/npm-cache --ignore-scripts --no-audit --no-fund --save-exact playwright@1.58.2 qrcode@1.5.4 @google/genai@2.30.0 typescript@6.0.3",
    "ai:check": "node --env-file-if-exists=.env scripts/ai-check.mjs",
    "test:ai": "node --test tests/ai*.test.mjs",
    "ai:verify": "node --env-file-if-exists=.env scripts/ai-verify.mjs",
    "test:ai:browser": "node scripts/test-ai-browser.mjs",
    "ai:skill:check": "node --env-file-if-exists=.env scripts/ai-skill-check.mjs"
  }
}
