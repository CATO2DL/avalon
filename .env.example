# Copy to .env and paste a NEW key locally. Never use a key disclosed in chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
AI_MAX_CALLS_PER_GAME=0
AI_MIN_INTERVAL_MS=12000

# Optional Chat Completions providers. Explicit model + key required; no automatic fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_BASE_URL=
